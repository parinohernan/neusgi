// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  rol          Rol
  creadoEn     DateTime  @default(now()) @map("creado_en")
  
  // Relaciones
  cliente      Cliente?
  presupuestos Presupuesto[]
  pagos        Pago[]
  cuentaCorriente CuentaCorriente[]
  
  @@map("usuarios")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nombreEmpresa String  @map("nombre_empresa") @db.VarChar(100)
  rutCuit      String   @unique @map("rut_cuit") @db.VarChar(30)
  direccion    String?  @db.Text
  telefono     String?  @db.VarChar(20)
  email        String?  @db.VarChar(100)
  usuarioId    Int?     @unique @map("usuario_id")
  
  // Relaciones
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  presupuestos Presupuesto[]
  cuentaCorriente CuentaCorriente[]
  
  @@map("clientes")
}

model Equipo {
  id                      Int      @id @default(autoincrement())
  patente                 String   @unique @db.VarChar(20)
  modelo                  String   @db.VarChar(50)
  capacidadKg             Decimal  @map("capacidad_kg") @db.Decimal(10, 2)
  estado                  EstadoEquipo @default(disponible)
  fechaUltimoMantenimiento DateTime? @map("fecha_ultimo_mantenimiento")
  imagenes                String?  @db.Text // JSON string con array de imágenes
  
  // Relaciones
  presupuestos Presupuesto[]
  
  @@map("equipos")
}

model Presupuesto {
  id         Int      @id @default(autoincrement())
  clienteId  Int      @map("cliente_id")
  equipoId   Int      @map("equipo_id")
  usuarioId  Int      @map("usuario_id")
  descripcion String  @db.Text
  costo      Decimal  @db.Decimal(12, 2)
  validoHasta DateTime @map("valido_hasta")
  estado     EstadoPresupuesto @default(pendiente)
  creadoEn   DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  equipo     Equipo   @relation(fields: [equipoId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  ordenCompra OrdenCompra?
  
  @@map("presupuestos")
}

model OrdenCompra {
  id           Int      @id @default(autoincrement())
  presupuestoId Int     @unique @map("presupuesto_id")
  fechaInicio  DateTime @map("fecha_inicio")
  fechaFin     DateTime @map("fecha_fin")
  origen       String   @db.VarChar(100)
  destino      String   @db.VarChar(100)
  observaciones String? @db.Text
  estado       EstadoOrdenCompra @default(activa)
  
  // Relaciones
  presupuesto  Presupuesto @relation(fields: [presupuestoId], references: [id])
  partesDiario ParteDiario[]
  remitos      Remito[]
  certificados Certificado[]
  facturas     Factura[]
  cuentaCorriente CuentaCorriente[]
  
  @@map("ordenes_compra")
}

model ParteDiario {
  id                  Int      @id @default(autoincrement())
  ordenCompraId       Int      @map("orden_compra_id")
  fecha               DateTime
  kmInicial           Int      @map("km_inicial")
  kmFinal             Int      @map("km_final")
  kmRecorridos        Int      @map("km_recorridos")
  horasTrabajadas     Decimal  @map("horas_trabajadas") @db.Decimal(5, 2)
  combustibleConsumido Decimal? @map("combustible_consumido") @db.Decimal(8, 2)
  incidencias         String?  @db.Text
  observaciones       String?  @db.Text
  archivosAdjuntos    Json?    @map("archivos_adjuntos")
  creadoEn            DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  ordenCompra         OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  
  @@map("partes_diario")
}

model Remito {
  id                Int      @id @default(autoincrement())
  ordenCompraId     Int      @map("orden_compra_id")
  codigo            String   @unique @db.VarChar(50)
  contenido         String   @db.Text
  pdfPath           String?  @map("pdf_path") @db.VarChar(255)
  archivosAdjuntos  Json?    @map("archivos_adjuntos")
  observaciones     String?  @db.Text
  estado            EstadoRemito @default(pendiente)
  creadoEn          DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  ordenCompra       OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  
  @@map("remitos")
}

model Certificado {
  id                Int      @id @default(autoincrement())
  ordenCompraId     Int      @map("orden_compra_id")
  tipo              TipoCertificado
  codigo            String   @unique @db.VarChar(50)
  descripcion       String   @db.Text
  fechaVencimiento  DateTime @map("fecha_vencimiento")
  pdfPath           String?  @map("pdf_path") @db.VarChar(255)
  archivosAdjuntos  Json?    @map("archivos_adjuntos")
  observaciones     String?  @db.Text
  estado            EstadoCertificado @default(activo)
  creadoEn          DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  ordenCompra       OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  
  @@map("certificados")
}

model Factura {
  id            Int      @id @default(autoincrement())
  ordenCompraId Int      @map("orden_compra_id")
  numeroFactura String   @unique @map("numero_factura") @db.VarChar(50)
  fechaEmision  DateTime @map("fecha_emision")
  fechaVencimiento DateTime @map("fecha_vencimiento")
  monto         Decimal  @db.Decimal(12, 2)
  montoPagado   Decimal? @map("monto_pagado") @db.Decimal(12, 2)
  saldoPendiente Decimal? @map("saldo_pendiente") @db.Decimal(12, 2)
  concepto      String   @db.Text
  observaciones String?  @db.Text
  pdfPath       String?  @map("pdf_path") @db.VarChar(255)
  archivosAdjuntos Json? @map("archivos_adjuntos")
  estado        EstadoFactura @default(pendiente)
  creadoEn      DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  pagos         Pago[]
  cuentaCorriente CuentaCorriente[]
  
  @@map("facturas")
}

model Pago {
  id            Int      @id @default(autoincrement())
  facturaId     Int      @map("factura_id")
  monto         Decimal  @db.Decimal(12, 2)
  fechaPago     DateTime @map("fecha_pago")
  metodoPago    MetodoPago @map("metodo_pago")
  referencia    String?  @db.VarChar(100)
  observaciones String?  @db.Text
  comprobante   String?  @map("comprobante") @db.VarChar(255)
  archivosAdjuntos Json? @map("archivos_adjuntos")
  estado        EstadoPago @default(confirmado)
  procesadoPor  Int?     @map("procesado_por")
  creadoEn      DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  factura       Factura @relation(fields: [facturaId], references: [id])
  usuario       Usuario? @relation(fields: [procesadoPor], references: [id])
  cuentaCorriente CuentaCorriente[]
  
  @@map("pagos")
}

model CuentaCorriente {
  id            Int      @id @default(autoincrement())
  clienteId     Int      @map("cliente_id")
  tipoMovimiento TipoMovimiento @map("tipo_movimiento")
  referencia    String   @db.VarChar(100)
  descripcion   String   @db.Text
  monto         Decimal  @db.Decimal(12, 2)
  saldoAnterior Decimal  @map("saldo_anterior") @db.Decimal(12, 2)
  saldoNuevo    Decimal  @map("saldo_nuevo") @db.Decimal(12, 2)
  fechaMovimiento DateTime @map("fecha_movimiento")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  facturaId     Int?     @map("factura_id")
  pagoId        Int?     @map("pago_id")
  ordenCompraId Int?     @map("orden_compra_id")
  observaciones String?  @db.Text
  estado        EstadoCuentaCorriente @default(activo)
  procesadoPor  Int?     @map("procesado_por")
  creadoEn      DateTime @default(now()) @map("creado_en")
  
  // Relaciones
  cliente       Cliente @relation(fields: [clienteId], references: [id])
  factura       Factura? @relation(fields: [facturaId], references: [id])
  pago          Pago? @relation(fields: [pagoId], references: [id])
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  usuario       Usuario? @relation(fields: [procesadoPor], references: [id])
  
  @@map("cuenta_corriente")
}

// Enums
enum Rol {
  admin
  logistica
  cliente_externo
}

enum EstadoEquipo {
  disponible
  mantenimiento
  ocupado
}

enum EstadoPresupuesto {
  pendiente
  aceptado
  rechazado
}

enum EstadoOrdenCompra {
  activa
  completada
  cancelada
}

enum TipoCertificado {
  seguro
  habilitacion
  otros
}

enum EstadoFactura {
  pendiente
  pagada
  cancelada
}

enum EstadoRemito {
  pendiente
  entregado
  cancelado
}

enum EstadoCertificado {
  activo
  vencido
  cancelado
}

enum MetodoPago {
  efectivo
  transferencia
  cheque
  tarjeta_credito
  tarjeta_debito
  otros
}

enum EstadoPago {
  pendiente
  confirmado
  rechazado
  cancelado
}

enum TipoMovimiento {
  factura
  pago
  ajuste
  nota_credito
  nota_debito
  otros
}

enum EstadoCuentaCorriente {
  activo
  cancelado
  vencido
} 